{
  "name": "vegui-network-profiler",
  "main": "src/cloudflare.ts",
  "compatibility_date": "2026-10-27",
  "durable_objects": { "bindings": [{ "name": "SERVERS", "class_name": "ServerRelay" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ServerRelay"] }],
  "assets": { "directory": "../profiler-web/dist", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
  "vars": { "PUBLIC_ORIGIN": "https://vnp.vegui.dev" }
}
