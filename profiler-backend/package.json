{
  "name": "vegui-network-profiler-backend",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/node.ts",
    "start": "tsx src/node.ts",
    "build": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "dev:cloudflare": "wrangler dev",
    "deploy:cloudflare": "wrangler deploy",
    "check:cloudflare": "wrangler deploy --dry-run --outdir dist/worker"
  },
  "dependencies": { "hono": "4.13.14", "@hono/node-server": "2.1.5", "ws": "8.22.0" },
  "devDependencies": { "@cloudflare/workers-types": "latest", "@types/node": "^24.0.0", "@types/ws": "^8.18.0", "tsx": "^4.20.0", "typescript": "7.0.2", "wrangler": "4.153.0" }
}
